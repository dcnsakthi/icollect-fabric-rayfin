# Copy this file to `.env` and fill in the values for your own Fabric tenant.
# `.env` is git-ignored; this sample is the tracked reference.
#
# Vite reads `.env`; `rayfin env` only regenerates `.env.local`, so values you
# put in `.env` survive redeploys.

# SPA application (client) ID for the Entra registration used to call Fabric APIs.
# Not a secret: public clients are protected by PKCE and the redirect URI allowlist.
# Create the registration in Entra ID, add a Single-page application redirect URI
# for your hosting URL plus `<hosting-url>/auth-redirect.html`, and grant the
# Fabric delegated scopes listed in README.md.
VITE_FABRIC_GRAPHQL_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Product name. Drives the browser tab title (index.html), the app header, and
# the sign-in screen.
VITE_APP_NAME=iCollect

# VITE_FABRIC_TENANT_ID is NOT set here — `rayfin env` generates it into .env.local
# from RAYFIN_PUBLIC_TENANT_ID in rayfin/.env.

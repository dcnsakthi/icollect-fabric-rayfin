# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules

# Build output
dist
dist-ssr
*.tsbuildinfo
.vite

# Test coverage
coverage

# Local env files (`*.local` matches `.env.local`, `.env.*.local`, etc.)
*.local

# Environment config — real tenant/workspace values never enter the repo.
.env
.env.*

# Rayfin — auto-generated or secret-bearing files
# `rayfin/.env*` covers .env, .env.bak (emitted by env-file v2 migration with
# secrets), and any future .env-family files Rayfin's runtime adds.
rayfin/.env*
rayfin/.deployments.json
rayfin/.temp/

# Placeholder samples stay tracked. Negations must come after the rules above.
!.env.sample
!rayfin/.env.sample

# Screenshots — in-app captures carry the signed-in user's email address and
# whatever business data was on screen. Redact before tracking any of these.
docs/images/

# Editor / OS
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.playwrite-mcp
.vscode
node_modules
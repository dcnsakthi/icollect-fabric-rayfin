# Rayfin environment configuration — SAMPLE.
#
# Do not copy this by hand. Run `npx rayfin init` (or `npx rayfin env`) against
# your own Fabric workspace and the CLI writes the real `rayfin/.env` for you.
# This file exists so the shape of the config is visible in source control;
# `rayfin/.env` itself is git-ignored because the values are tenant-specific.
#
# See docs/rfc/env-file-strategy.md for the full variable reference.

# Local dev server port for `rayfin dev`.
RAYFIN_PUBLIC_FRONTEND_PORT=5173

# AppBackend endpoint, issued by Fabric when the app item is created.
RAYFIN_PUBLIC_API_URL=https://<capacity-id>.pbidedicated.windows.net/webapi/capacities/<CAPACITY-ID>/workloads/BaaS/BaaSService/automatic/v1/workspaces/<workspace-id>/appbackends/<appbackend-item-id>/

# Public client key for the AppBackend. Not a bearer secret, but environment-specific.
RAYFIN_PUBLIC_PUBLISHABLE_KEY=pk-xxxxxxxxxxxxxxxxxxxx

# Fabric item ID of the AppBackend.
RAYFIN_PUBLIC_ITEM_ID=00000000-0000-0000-0000-000000000000

# Fabric workspace that hosts the app and its data items.
RAYFIN_PUBLIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# Entra tenant. `rayfin env` copies this into VITE_FABRIC_TENANT_ID in .env.local.
RAYFIN_PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000000

# Fabric portal used for the sign-in handshake.
RAYFIN_PUBLIC_PORTAL_URL=https://app.fabric.microsoft.com
